{
	"tabWidth": 4,
	"trailingComma": "none",
	"singleQuote": true,
	"bracketSpacing": true,
	"jsxSingleQuote": true,
	"useTabs": true,
	"semi": false,
	"arrowParens": "avoid",

	"importOrderSeparation": true,
	"importOrderSortSpecifiers": true,
	"importOrderCaseInsensitive": true,
	"importOrderParserPlugins": [
		"classProperties",
		"decorators-legacy",
		"typescript"
	],
	"importOrder": [
		"<THIRD_PARTY_MODULES>",
		"^@(.*)$",
		"^../(.*)$",
		"^./(.*)$"
	],
	"plugins": ["@trivago/prettier-plugin-sort-imports"]
}
